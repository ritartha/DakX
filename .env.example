# ── Django ──
SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DOMAIN=localhost
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Database (only needed for production / PostgreSQL) ──
# DATABASE_URL=postgres://dakx:dakx@localhost:5432/dakx

# ── Redis (only needed for production) ──
# REDIS_URL=redis://localhost:6379/1

# ── Email (only needed for production SMTP) ──
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# ── S3/MinIO (only needed for production file storage) ──
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_STORAGE_BUCKET_NAME=dakx-media
# AWS_S3_ENDPOINT_URL=http://localhost:9000

# ── Celery (only needed for production async tasks) ──
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── JWT ──
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
